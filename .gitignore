node_modules/
dist/
server/data/
*.log
.venv/
__pycache__/
pipeline/data/*
!pipeline/data/compare_results.json

server/.env

# generated deck builds (rebuilt by presentation/build.mjs and build-ai.mjs)
presentation/deck.html
presentation/deck.fragment.html
presentation/ai-deck.html
presentation/ai-deck.fragment.html

# render inputs and outputs (large; the textures are fetched by pipeline/render/fetch_textures.py, CC0)
pipeline/render/in/
pipeline/render/out/
pipeline/render/textures/*
!pipeline/render/textures/CREDITS.md
# Unreal project: the .uproject and its renderer settings are source, the rest (caches, imported assets, the saved level) is generated by import_scene.py and build_level.py
pipeline/render/unreal/UsableSpace/*
!pipeline/render/unreal/UsableSpace/UsableSpace.uproject
!pipeline/render/unreal/UsableSpace/Config/
pipeline/render/unreal/UsableSpace/Config/*
!pipeline/render/unreal/UsableSpace/Config/DefaultEngine.ini
!pipeline/render/unreal/UsableSpace/Content/
pipeline/render/unreal/UsableSpace/Content/*
!pipeline/render/unreal/UsableSpace/Content/Python/
pipeline/render/unreal/*.log

# Revit: the add-in's build output, and the unpacked template files
pipeline/revit/TemplateExport/bin/
pipeline/revit/TemplateExport/obj/
pipeline/data/revit/_rte/
pipeline/revit/DemoBuild/bin/
pipeline/revit/DemoBuild/obj/

# Pixel Streaming: Epic's web part (downloaded and built by pipeline/render/unreal/pixelstreaming/setup.ps1) and its logs
pipeline/render/unreal/pixelstreaming/infra/
pipeline/render/unreal/pixelstreaming/logs/

# the house pack (built by pipeline/render/unreal/house/make_house_pack.py from the UsableSpace project) and the logs of its scripts
pipeline/render/unreal/house/pack/
pipeline/render/unreal/house/logs/

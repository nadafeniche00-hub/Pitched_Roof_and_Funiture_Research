<Project Sdk="Microsoft.NET.Sdk">
  <!-- A throw-away Revit 2025 add-in: opens a Revit sample project (read only) and writes its attic storey, the Dachgeschoss, as JSON: rooms with areas and boundaries, walls, floors, roofs, doors, windows, stairs.
       Build and run with run.ps1 (it installs the add-in temporarily and removes it again). This Revit 2025 build (25.5.10) runs on .NET 10, like TemplateExport. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SampleExport</AssemblyName>
    <RevitDir>C:\Program Files\Autodesk\Revit 2025\</RevitDir>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

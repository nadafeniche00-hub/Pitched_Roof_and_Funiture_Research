<Project Sdk="Microsoft.NET.Sdk">
  <!-- A throw-away Revit 2025 add-in: opens the German project templates and writes their roof types, layers and materials as JSON.
       Build and run with run.ps1 (it installs the add-in temporarily and removes it again). this Revit 2025 build (25.5.10) runs on .NET 10. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TemplateExport</AssemblyName>
    <RevitDir>C:\Program Files\Autodesk\Revit 2025\</RevitDir>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>

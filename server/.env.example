# Copy to server/.env (git-ignored) and fill in. Nothing is sent to a model server unless all three of the first lines are set.
# The team's Open WebUI on the GX10: http://193.16.125.8:3000 ; make a key under Settings > Account > API keys.
LLM_URL=http://193.16.125.8:3000/api
LLM_API_KEY=
LLM_MODEL=
# Only if a different model reads images (Qwen2.5-VL, for example); defaults to LLM_MODEL
LLM_VISION_MODEL=

# Sketch reading: how many times a plan that fails the checker (overlaps, holes, rooms outside the outline) goes back to the model with the measured reasons. 0 = ask once.
# AI_REPAIR_ROUNDS=2
